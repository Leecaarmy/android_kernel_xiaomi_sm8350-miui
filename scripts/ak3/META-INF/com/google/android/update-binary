#!/sbin/sh
# SPDX-License-Identifier: GPL-2.0
# Dynamic minimal recovery entry point for the AnyKernel3 ZIP layout.
# Uses the bundled AnyKernel3 BusyBox; does not run upstream mount/patch helpers.
set -eu
OUTFD="$2"
ZIPFILE="$3"
ui_print() { printf 'ui_print %s\nui_print\n' "$*" > "/proc/self/fd/$OUTFD"; }
[ -d /tmp ] || { ui_print 'ERROR: Recovery /tmp is required'; exit 1; }
WORK=$(mktemp -d /tmp/dynamic-ak3.XXXXXX)
case "$WORK" in /tmp/dynamic-ak3.*) ;; *) exit 1;; esac
unzip -p "$ZIPFILE" tools/busybox > "$WORK/busybox" || exit 1
chmod 755 "$WORK/busybox"
BB="$WORK/busybox"
"$BB" unzip -o "$ZIPFILE" -d "$WORK" >/dev/null || exit 1
"$BB" mkdir "$WORK/bin"
"$BB" --install -s "$WORK/bin"
export PATH="$WORK/bin:/sbin:/system/bin:/system/xbin:/vendor/bin"
if "$BB" sh "$WORK/anykernel.sh" "$OUTFD" "$WORK"; then
    "$BB" rm -rf "$WORK"
else
    ui_print "Installation stopped. Diagnostic files remain in $WORK until reboot."
    exit 1
fi
